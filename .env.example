# Домены через запятую (A-записи на IP сервера) — Caddy сам выпустит HTTPS, www редиректится на основной:
# DOMAIN=penny.place, www.penny.place, okayconnect.online, www.okayconnect.online
# :80 — сайт по http, без сертификата (локально).
DOMAIN=:80

# Основной домен: остальные домены из DOMAIN (например, старый адрес) редиректятся на него.
# Пусто — каждый домен из DOMAIN работает сам по себе.
# CANONICAL_HOST=penny.place
CANONICAL_HOST=

# Адрес сайта, как его видит браузер: от него зависят cookie (https → Secure)
# и адрес возврата из Google.
PUBLIC_URL=http://localhost

# Вход через Google — необязателен, без этих строк кнопки нет.
# OAuth client (Web application) в Google Cloud Console,
# Authorized redirect URI: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Пароль Postgres. База запоминает его при первом запуске, менять потом бесполезно.
# deploy.sh сгенерирует его сам, если строки нет.
DB_PASSWORD=
