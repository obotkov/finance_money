{$DOMAIN:localhost} {
	# www.example.com → example.com
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# Остальные домены из DOMAIN (старый адрес) ведут на основной CANONICAL_HOST.
	# Без CANONICAL_HOST каждый домен работает сам по себе.
	@alias expression `{env.CANONICAL_HOST} != "" && {host} != {env.CANONICAL_HOST}`
	redir @alias https://{env.CANONICAL_HOST}{uri} permanent

	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@html path / /index.html
	header @html Cache-Control "no-cache"
}
